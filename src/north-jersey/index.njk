---
layout: layouts/base.njk
title: North Jersey
permalink: /north-jersey/index.html
---

{% set publication = market.latestPublication %}

<!-- HERO -->
<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <h1>North Jersey <span class="sponsor-inline"> · presented by <a href="https://www.performancekiaofdenville.com/" target="_blank">Kia of Denville</a></span></h1>
        <p>Bergen · Passaic · Essex · Hudson · Morris · Sussex · Warren · Hunterdon · Somerset · Union · Middlesex</p>
        <p class="support-line">Support Yokal Sports Sports Creators — Become A Yokal.</p>
      </div>
      <a class="btn primary-yokal" href="#" data-ms-modal="signup" data-ms-price:add="prc_yokal-nj-monthly-x3470asv">Become a Yokal</a>
    </div>

    <div class="subscribe-block">
      <div>
        <div class="eyebrow">Free Every Tuesday</div>
        <h2>Subscribe to the YSSR</h2>
        <p>Rankings, school sports stories, local athletes and the market updates that matter.</p>
      </div>
      <div class="subscribe-form-wrap">
        <input type="email" id="yssr-email" placeholder="Enter your email" class="subscribe-input">
        <button onclick="yssrSubscribe()" class="subscribe-btn">Subscribe Free</button>
        <p id="yssr-msg" style="display:none;margin:6px 0 0;font-size:11px;color:var(--lime);font-weight:900;"></p>
      </div>
    </div>
    <script>
    async function yssrSubscribe() {
      const email = document.getElementById('yssr-email').value;
      const msg = document.getElementById('yssr-msg');
      if (!email) return;
      try {
        const res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: {'Content-Type':'application/json'},
          body: JSON.stringify({email, market:'north-jersey'})
        });
        const data = await res.json();
        msg.style.display = 'block';
        msg.textContent = data.success ? "You're in! Check your inbox for the YSSR." : 'Something went wrong. Try again.';
        if (data.success) document.getElementById('yssr-email').value = '';
      } catch(e) {
        msg.style.display = 'block';
        msg.textContent = 'Something went wrong. Try again.';
      }
    }
    document.getElementById('yssr-email').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') yssrSubscribe();
    });
    </script>

<div class="issues">
  {% if market.newsletter_issues and market.newsletter_issues.length %}
    {% for issue in market.newsletter_issues | take(4) %}
      <a class="issue-card" href="{{ issue.url }}" target="_blank" rel="noopener">
        <div class="date">{{ issue.label or (issue.date | displayDate) }}</div>
        <h3>{{ issue.title }}</h3>
      </a>
    {% endfor %}
  {% else %}
    <a class="issue-card" href="https://yokalsports.beehiiv.com/p/the-yokal-sports-sports-report-north-jersey-a1d2b83513613958" target="_blank" rel="noopener">
      <div class="date">June 16, 2026</div>
      <h3>YSSR North Jersey — June 16, 2026</h3>
    </a>
    <a class="issue-card" href="https://yokalsports.beehiiv.com/p/the-yokal-sports-sports-report-north-jersey-32fd15c4d24a3a1b" target="_blank" rel="noopener">
      <div class="date">June 9, 2026</div>
      <h3>State Playoffs Are in Full Mode — Top Stories You Need to Know</h3>
    </a>
    <a class="issue-card" href="https://yokalsports.beehiiv.com/p/the-yokal-sports-sports-report-north-jersey-9bc3d0f08b3ba4cb" target="_blank" rel="noopener">
      <div class="date">May 26, 2026</div>
      <h3>15 North Jersey Schools That Deserve Some Love This Spring</h3>
    </a>
    <a class="issue-card" href="https://yokalsports.beehiiv.com/p/the-yokal-sports-sports-report-north-jersey-aa7940a04e688577" target="_blank" rel="noopener">
      <div class="date">May 19, 2026</div>
      <h3>Mount Olive Stuns Delbarton + County Finals &amp; College Corner</h3>
    </a>
  {% endif %}
</div>
  </div>
</section>

{% if publication %}

<!-- CURRENT YSSR RANKINGS -->
<section class="section">
  <div class="wrap">
    <div class="section-head" style="align-items:flex-start;">
      <div>
        <div class="section-label">{{ publication.week or "Week 0" }} · {{ publication.season }}</div>
        <h2 class="section-title">North Jersey High School YSSR Scores</h2>
        <p class="section-sub">Published {{ publication.display_date or (publication.publish_date | displayDate) }}</p>
      </div>
    </div>

    <style>
      .yssr-board-grid{display:grid;grid-template-columns:1fr;gap:12px}
      .yssr-board .card-head{align-items:center}
      .yssr-board .board-range{font-size:10px;font-weight:900;text-transform:uppercase;letter-spacing:.06em;color:var(--green);margin-top:3px}
      .yssr-board table{table-layout:auto}
      .yssr-board th:last-child{text-align:right}
      .yssr-board td.recent-cell{color:#214b2d;font-weight:700;font-size:10px;line-height:1.25}
      .yssr-board td.team-cell strong{color:var(--navy)}
      .yssr-board td.team-cell .record{color:var(--muted);font-size:10px;font-weight:800;margin-left:3px}
      .yssr-board td.score-cell{text-align:right;width:105px;background:#eef7e8!important}
      .yssr-board .score-highlight{display:inline-block;min-width:64px;text-align:center;padding:5px 7px;border:2px solid var(--green);border-radius:7px;background:#fff;color:var(--green);font-size:18px;line-height:1;font-weight:900;letter-spacing:-.03em}
      @media(min-width:900px){
        .yssr-board-grid{grid-template-columns:1fr 1fr}
        .yssr-board.full-width{grid-column:1 / -1}
        .yssr-board td.recent-cell{font-size:11px}
        .yssr-board .score-highlight{font-size:20px}
      }
    </style>

    <div class="yssr-board-grid">
      {% for sport in publication.high_school.boys.sports %}
        {% if sport.teams and sport.teams.length %}

          {% if sport.teams.length > 25 %}
          <div class="data-card yssr-board">
            <div class="card-head">
              <div>
                <h3>{{ sport.name }} YSSR Scores</h3>
                <div class="board-range">Teams 1–25</div>
              </div>
              <div class="date-line">{{ publication.week }} · {{ publication.display_date or (publication.publish_date | displayDate) }}</div>
            </div>
            <div class="table-wrap"><table>
              <thead><tr><th>Rank</th><th>Team</th><th>Recent</th><th>YSSR Score</th></tr></thead>
              <tbody>
                {% for team in sport.teams %}{% if team.rank >= 1 and team.rank <= 25 %}
                <tr>
                  <td class="rank">{{ team.rank }}</td>
                  <td class="team-cell"><strong>{{ team.team }}</strong>{% if team.record %}<span class="record">({{ team.record }})</span>{% endif %}</td>
                  <td class="recent-cell">{{ team.recent or "—" }}</td>
                  <td class="score-cell"><span class="score-highlight">{{ team.score }}</span></td>
                </tr>
                {% endif %}{% endfor %}
              </tbody>
            </table></div>
            <a class="sponsor-slot" href="mailto:yokals@yokalsports.com?subject=Sponsor {{ sport.name }} YSSR Scores">Sponsor This YSSR Board →</a>
          </div>

          <div class="data-card yssr-board">
            <div class="card-head">
              <div>
                <h3>{{ sport.name }} YSSR Scores</h3>
                <div class="board-range">Teams 26–50</div>
              </div>
              <div class="date-line">{{ publication.week }} · {{ publication.display_date or (publication.publish_date | displayDate) }}</div>
            </div>
            <div class="table-wrap"><table>
              <thead><tr><th>Rank</th><th>Team</th><th>Recent</th><th>YSSR Score</th></tr></thead>
              <tbody>
                {% for team in sport.teams %}{% if team.rank >= 26 and team.rank <= 50 %}
                <tr>
                  <td class="rank">{{ team.rank }}</td>
                  <td class="team-cell"><strong>{{ team.team }}</strong>{% if team.record %}<span class="record">({{ team.record }})</span>{% endif %}</td>
                  <td class="recent-cell">{{ team.recent or "—" }}</td>
                  <td class="score-cell"><span class="score-highlight">{{ team.score }}</span></td>
                </tr>
                {% endif %}{% endfor %}
              </tbody>
            </table></div>
            <a class="sponsor-slot" href="mailto:yokals@yokalsports.com?subject=Sponsor {{ sport.name }} YSSR Scores">Sponsor This YSSR Board →</a>
          </div>

          {% else %}
          <div class="data-card yssr-board full-width">
            <div class="card-head">
              <div>
                <h3>{{ sport.name }} YSSR Scores</h3>
                <div class="board-range">Top {{ sport.teams.length }}</div>
              </div>
              <div class="date-line">{{ publication.week }} · {{ publication.display_date or (publication.publish_date | displayDate) }}</div>
            </div>
            <div class="table-wrap"><table>
              <thead><tr><th>Rank</th><th>Team</th><th>Recent</th><th>YSSR Score</th></tr></thead>
              <tbody>
                {% for team in sport.teams %}
                <tr>
                  <td class="rank">{{ team.rank }}</td>
                  <td class="team-cell"><strong>{{ team.team }}</strong>{% if team.record %}<span class="record">({{ team.record }})</span>{% endif %}</td>
                  <td class="recent-cell">{{ team.recent or "—" }}</td>
                  <td class="score-cell"><span class="score-highlight">{{ team.score }}</span></td>
                </tr>
                {% endfor %}
              </tbody>
            </table></div>
            <a class="sponsor-slot" href="mailto:yokals@yokalsports.com?subject=Sponsor {{ sport.name }} YSSR Scores">Sponsor This YSSR Board →</a>
          </div>
          {% endif %}

        {% endif %}
      {% endfor %}

      {% for sport in publication.high_school.girls.sports %}
        {% if sport.teams and sport.teams.length %}
          {% if sport.teams.length > 25 %}
            {% for rangeStart in [1,26] %}
            <div class="data-card yssr-board">
              <div class="card-head">
                <div>
                  <h3>{{ sport.name }} YSSR Scores</h3>
                  <div class="board-range">Teams {{ rangeStart }}–{{ rangeStart + 24 }}</div>
                </div>
                <div class="date-line">{{ publication.week }} · {{ publication.display_date or (publication.publish_date | displayDate) }}</div>
              </div>
              <div class="table-wrap"><table>
                <thead><tr><th>Rank</th><th>Team</th><th>Recent</th><th>YSSR Score</th></tr></thead>
                <tbody>
                  {% for team in sport.teams %}{% if team.rank >= rangeStart and team.rank <= rangeStart + 24 %}
                  <tr>
                    <td class="rank">{{ team.rank }}</td>
                    <td class="team-cell"><strong>{{ team.team }}</strong>{% if team.record %}<span class="record">({{ team.record }})</span>{% endif %}</td>
                    <td class="recent-cell">{{ team.recent or "—" }}</td>
                    <td class="score-cell"><span class="score-highlight">{{ team.score }}</span></td>
                  </tr>
                  {% endif %}{% endfor %}
                </tbody>
              </table></div>
              <a class="sponsor-slot" href="mailto:yokals@yokalsports.com?subject=Sponsor {{ sport.name }} YSSR Scores">Sponsor This YSSR Board →</a>
            </div>
            {% endfor %}
          {% else %}
            <div class="data-card yssr-board full-width">
              <div class="card-head">
                <div><h3>{{ sport.name }} YSSR Scores</h3><div class="board-range">Top {{ sport.teams.length }}</div></div>
                <div class="date-line">{{ publication.week }} · {{ publication.display_date or (publication.publish_date | displayDate) }}</div>
              </div>
              <div class="table-wrap"><table>
                <thead><tr><th>Rank</th><th>Team</th><th>Recent</th><th>YSSR Score</th></tr></thead>
                <tbody>{% for team in sport.teams %}
                  <tr>
                    <td class="rank">{{ team.rank }}</td>
                    <td class="team-cell"><strong>{{ team.team }}</strong>{% if team.record %}<span class="record">({{ team.record }})</span>{% endif %}</td>
                    <td class="recent-cell">{{ team.recent or "—" }}</td>
                    <td class="score-cell"><span class="score-highlight">{{ team.score }}</span></td>
                  </tr>
                {% endfor %}</tbody>
              </table></div>
              <a class="sponsor-slot" href="mailto:yokals@yokalsports.com?subject=Sponsor {{ sport.name }} YSSR Scores">Sponsor This YSSR Board →</a>
            </div>
          {% endif %}
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% endif %}

